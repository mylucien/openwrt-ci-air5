# Air5 defconfig — SoftBank Air5 (IPQ8072A) SPI-NOR OpenWrt boot
# Based on ipq807x_cdp_defconfig from QSDK 12.5
# Key changes:
#   + CONFIG_CMD_BOOTSPINOR    new boot command
#   + ENV_IS_IN_SPI_FLASH      env in APPSBLENV @ 0x1F0000
#   - CONFIG_QPIC_NAND         no NAND on Air5
#   - CONFIG_CMD_NAND          not needed
#   - CONFIG_QCA_MMC           no eMMC on Air5

CONFIG_ARM=y
CONFIG_SYS_TEXT_BASE=0x4A900000
CONFIG_TARGET_IPQ807X=y
CONFIG_DEFAULT_DEVICE_TREE="qcom-ipq8074-hk01"

# SPI Flash (W25R512NWEIQ 64MB 1.8V)
CONFIG_QCA_SPI=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_STMICRO=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_GIGADEVICE=y
CONFIG_CMD_SF=y
CONFIG_SPI_FLASH_BAR=y
CONFIG_SPI_FLASH_USE_4K_SECTORS=y

# ENV in SPI-NOR (APPSBLENV partition @ 0x1F0000)
CONFIG_ENV_IS_IN_SPI_FLASH=y

# NAND: disabled (not present on Air5)
# CONFIG_QPIC_NAND is not set
# CONFIG_CMD_NAND is not set

# eMMC: disabled (not present on Air5)
# CONFIG_QCA_MMC is not set
# CONFIG_CMD_MMC is not set

# Boot
CONFIG_CMD_BOOTSPINOR=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTZ=y
CONFIG_BOOTDELAY=3

# FIT image support
CONFIG_FIT=y
CONFIG_OF_LIBFDT=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_OF_COMBINE=y

# Network (for TFTP rescue)
CONFIG_IPQ807X_EDMA=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_PING=y
CONFIG_CMD_DHCP=y

# USB (optional rescue)
CONFIG_USB_XHCI_IPQ=y

# PCIe (for ath11k Wi-Fi)
CONFIG_PCI_IPQ=y

# Other standard options
CONFIG_CMD_RUN=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_UBI=y
CONFIG_CMD_MTDPARTS=y
CONFIG_MTD_DEVICE=y
CONFIG_MTD_PARTITIONS=y
CONFIG_RBTREE=y
CONFIG_EFI_PARTITION=y
CONFIG_QCA_BAM=y
CONFIG_QCA_APPSBL_DLOAD=y
CONFIG_SMP_CMD_SUPPORT=y
CONFIG_ARMV7_PSCI=y
CONFIG_IPQ_FDT_FIXUP=y
CONFIG_FDT_FIXUP_PARTITIONS=y
CONFIG_COMPRESSED_DTB_MAX_SIZE=0x40000
CONFIG_LIST_OF_CONFIG_NAMES_SUPPORT=y
CONFIG_HTTPD=y
CONFIG_DHCPD=y
