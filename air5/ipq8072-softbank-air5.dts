/dts-v1/;
#include "ipq8074.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "SoftBank Air 5 (IPQ8072A)";
	compatible = "softbank,air5", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart5;
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
		ethernet0  = &dp1;
		ethernet1  = &dp2;
		ethernet2  = &dp3;
		ethernet3  = &dp4;
		ethernet4  = &dp5;
		ethernet5  = &dp6;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x20000000>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_system: system {
			label = "green:system"; color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
		wifi {
			label = "blue:wifi"; 
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};
		wwan_5g {
			label = "blue:5g";
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
		};

		wwan_4g_red {
			label = "red:4g";
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
		};

		wwan_4g_green {
			label = "green:4g";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
		};

		sim_red {
			label = "red:sim";
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
		};

		sim_green {
			label = "green:sim";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 14 GPIO_ACTIVE_LOW>;
		};

		rf1_blue {
			label = "blue:rf1";
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
		};

		rf2_blue {
			label = "blue:rf2";
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
		};

		rf3_blue {
			label = "blue:rf3";
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 20 GPIO_ACTIVE_LOW>;
		};

		rf_red {
			label = "red:rf";
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
		};
	};
};

&tlmm {
	uart_pins: uart-state {
		pins = "gpio7", "gpio8";
		function = "blsp4_uart0";
		drive-strength = <8>; 
		bias-disable;
	};
	mdio_pins: mdio-state {
		mdc-pins {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mdio-pins {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
		phy-reset-0 {
			pins = "gpio25";
			function = "gpio";
			bias-pull-up;
		};
		phy-reset-1 {
			pins = "gpio44";
			function = "gpio";
			bias-pull-up;
		};
	};
	led_pins: led-state {
		pins = "gpio0", "gpio3", "gpio11", "gpio14", "gpio16",
		       "gpio18", "gpio19", "gpio20", "gpio42", "gpio43", "gpio51";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
	usb_mux_pins: usb-mux-state {
		pins = "gpio27";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-high;
	};
};

&blsp1_uart5 {
	status = "okay";
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
};

&prng      { status = "okay"; };
&cryptobam { status = "okay"; };
&crypto    { status = "okay"; };

&blsp1_spi1 {
	status = "okay";
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-gpios = <0>;
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <50000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@2a0000 {
				label = "0:art";
				reg = <0x2a0000 0x040000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					cal_art_wifi0: cal@1000 {
						reg = <0x1000 0x24a6>;
					};

					cal_art_wifi1: cal@35a6 {
						reg = <0x35a6 0x1ba5a>;
					};
				};
			};
			partition@400000 { 
				label = "kernel"; 
				reg = <0x400000 0x800000>; 
			};

			partition@c00000 { 
				label = "rootfs"; 
				reg = <0xc00000 0x3400000>; 
			};
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";

	reset-gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>,
	              <&tlmm 44 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	qca_phy0: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x08>;
	};

	qca_phy1: ethernet-phy@9 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x09>;
	};

	qca_phy2: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x02>;
	};

	qca_phy3: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x03>;
	};

	aqr_phy0: ethernet-phy@18 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x18>;
	};

	aqr_phy1: ethernet-phy@1c {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1c>;
	};
};

&switch {
	status = "okay";

	switch_lan_bmp   = <0x3e>;
	switch_wan_bmp   = <0x40>;
	switch_mac_mode  = <0x00>;
	switch_mac_mode1 = <0x0f>;
	switch_mac_mode2 = <0x0f>;
	bm_tick_mode     = <0x00>;
	tm_tick_mode     = <0x00>;

	qcom,port_phyinfo {
		port@1 {
			port_id     = <1>;
			phy_address = <8>;	/* qca_phy0 */
		};
		port@2 {
			port_id     = <2>;
			phy_address = <9>;	/* qca_phy1 */
		};
		port@3 {
			port_id     = <3>;
			phy_address = <2>;	/* qca_phy2 */
		};
		port@4 {
			port_id     = <4>;
			phy_address = <3>;	/* qca_phy3 */
		};
		port@5 {
			port_id      = <5>;
			phy_address  = <0x18>;	/* aqr_phy0 */
			port_mac_sel = "QGMAC_PORT";
		};
		port@6 {
			port_id      = <6>;
			phy_address  = <0x1c>;	/* aqr_phy1 */
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&edma {
	status = "okay";
};

&soc {
	watchdog@b017000 {
	    compatible = "qcom,kpss-wdt-ipq807x", "qcom,kpss-wdt";
	    reg = <0xb017000 0x1000>;
	    clocks = <&sleep_clk>;
	    timeout-sec = <32>;
	    status = "okay";
	};
};

&wifi {
	status = "okay";
	nvmem-cells = <&cal_art_wifi0>, <&cal_art_wifi1>;
	nvmem-cell-names = "calibration", "pre-calibration";
};

&pcie0 {
	status = "okay";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
};

&pcie1    { status = "disabled"; };
&ssphy_0  { status = "okay"; };
&ssphy_1  { status = "okay"; };
&qusb_phy_0 { status = "okay"; };
&qusb_phy_1 { status = "okay"; };
&usb_0    { status = "okay"; };
&usb_1    { status = "okay"; };
